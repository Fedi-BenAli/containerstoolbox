apiVersion: kyverno.io/v1
kind: ClusterPolicy
metadata:
  name: deny-secret-service-account-token-type
  annotations:
    policies.kyverno.io/title: Interdire le type de Secret 'kubernetes.io/service-account-token'
    policies.kyverno.io/description: Empêche la création de Secrets de type 'kubernetes.io/service-account-token'.
spec:
  validationFailureAction: Enforce
  background: false
  rules:
    - name: block-service-account-token-secret
      match:
        resources:
          kinds:
            - Secret
      validate:
        message: "La création de Secrets de type 'kubernetes.io/service-account-token' est interdite."
        deny:
          conditions:
            all:
              - key: "{{request.object.type || ''}}"
                operator: Equals
                value: "kubernetes.io/service-account-token"


