apiVersion: kyverno.io/v1
kind: ClusterPolicy
metadata:
  name: forbid-poddisruptionbudget
  annotations:
    policies.kyverno.io/title: Interdire les PodDisruptionBudget
    policies.kyverno.io/description: Empêche la création de ressources PodDisruptionBudget.
spec:
  validationFailureAction: Enforce
  background: false
  rules:
    - name: block-pdb-creation
      match:
        resources:
          kinds:
            - PodDisruptionBudget
      validate:
        message: "La création de PodDisruptionBudget n'est pas autorisée sur ce cluster."
        deny: {}


