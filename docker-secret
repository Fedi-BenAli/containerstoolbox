#!/usr/bin/env bash
#
# create-harbor-secret.sh
# Generates a Kubernetes Secret of type kubernetes.io/dockerconfigjson
# for pulling images from a Harbor registry.
#
set -euo pipefail

SECRET_NAME="harbor-registry-secret"
NAMESPACE="default"
OUTPUT_FILE=""
APPLY=false
USERNAME=""
TOKEN="${HARBOR_TOKEN:-}"
REGISTRY=""

usage() {
  cat <<EOF
Usage: $(basename "$0") -u <username> -r <registry-url> [-t <token>] [options]

Required:
  -u  Harbor username (use single quotes for robot accounts, e.g. 'robot\$ci')
  -r  Harbor registry URL (e.g. harbor.example.com or https://harbor.example.com)

Token (one of):
  -t  Harbor token / password
      or set the HARBOR_TOKEN environment variable
      or leave empty to be prompted securely

Options:
  -n  Secret name        (default: ${SECRET_NAME})
  -N  Namespace          (default: ${NAMESPACE})
  -o  Write YAML to file (default: print to stdout)
  -a  Apply directly to the cluster with kubectl
  -h  Show this help

Examples:
  $(basename "$0") -u myuser -r harbor.example.com -N my-app -o secret.yaml
  HARBOR_TOKEN=xxxx $(basename "$0") -u 'robot\$ci' -r https://harbor.example.com -a
EOF
  exit "${1:-0}"
}

while getopts ":u:t:r:n:N:o:ah" opt; do
  case "$opt" in
    u) USERNAME="$OPTARG" ;;
    t) TOKEN="$OPTARG" ;;
    r) REGISTRY="$OPTARG" ;;
    n) SECRET_NAME="$OPTARG" ;;
    N) NAMESPACE="$OPTARG" ;;
    o) OUTPUT_FILE="$OPTARG" ;;
    a) APPLY=true ;;
    h) usage 0 ;;
    :) echo "Error: option -$OPTARG requires an argument" >&2; usage 1 ;;
    \?) echo "Error: unknown option -$OPTARG" >&2; usage 1 ;;
  esac
done

# Validate inputs
[[ -z "$USERNAME" ]] && { echo "Error: username (-u) is required" >&2; usage 1; }
[[ -z "$REGISTRY" ]] && { echo "Error: registry URL (-r) is required" >&2; usage 1; }

# Prompt for token if not supplied (keeps it out of shell history / ps)
if [[ -z "$TOKEN" ]]; then
  read -r -s -p "Harbor token for ${USERNAME}: " TOKEN
  echo >&2
  [[ -z "$TOKEN" ]] && { echo "Error: token cannot be empty" >&2; exit 1; }
fi

# Normalise registry: strip scheme and trailing slashes -> host[:port]
REGISTRY="${REGISTRY#http://}"
REGISTRY="${REGISTRY#https://}"
REGISTRY="${REGISTRY%%/*}"

# Escape backslashes and double quotes for JSON
json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  printf '%s' "$s"
}

b64() { base64 | tr -d '\n'; }

AUTH="$(printf '%s:%s' "$USERNAME" "$TOKEN" | b64)"

DOCKER_CONFIG_JSON="$(printf '{"auths":{"%s":{"username":"%s","password":"%s","auth":"%s"}}}' \
  "$(json_escape "$REGISTRY")" \
  "$(json_escape "$USERNAME")" \
  "$(json_escape "$TOKEN")" \
  "$AUTH")"

DOCKER_CONFIG_B64="$(printf '%s' "$DOCKER_CONFIG_JSON" | b64)"

SECRET_YAML="$(cat <<EOF
apiVersion: v1
kind: Secret
metadata:
  name: ${SECRET_NAME}
  namespace: ${NAMESPACE}
type: kubernetes.io/dockerconfigjson
data:
  .dockerconfigjson: ${DOCKER_CONFIG_B64}
EOF
)"

if $APPLY; then
  command -v kubectl >/dev/null 2>&1 || { echo "Error: kubectl not found in PATH" >&2; exit 1; }
  printf '%s\n' "$SECRET_YAML" | kubectl apply -f -
elif [[ -n "$OUTPUT_FILE" ]]; then
  umask 077
  printf '%s\n' "$SECRET_YAML" > "$OUTPUT_FILE"
  echo "Secret manifest written to ${OUTPUT_FILE}" >&2
else
  printf '%s\n' "$SECRET_YAML"
fi
